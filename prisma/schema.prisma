// Schema de base de données pour l'application de gestion commerçant.
// PostgreSQL (hébergé sur Neon, connecté via l'intégration Vercel Marketplace).
// En développement local, DATABASE_URL pointe vers la branche Neon "development"
// (voir .env.local, généré par `vercel install neon` / `vercel env pull`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTIONNAIRE
  VENDEUR
}

model Store {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("boutique") // quincaillerie, pharmacie, boutique, autre
  address        String?
  phone          String?
  currency       String   @default("CDF")
  taxRate        Float    @default(16)
  taxId          String? // Identifiant fiscal / NIF, affiché sur les factures
  rccm           String? // N° Registre de commerce, affiché sur les factures
  invoiceCounter Int      @default(0) // Compteur séquentiel pour la numérotation des factures
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      StoreMembership[]
  products         Product[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  expenses         Expense[]
  stockMovements   StockMovement[]
  mobileMoneyTx    MobileMoneyTransaction[]
  customers        Customer[]
  customerPayments CustomerPayment[]
  saleReturns      SaleReturn[]
  inventories      InventoryCount[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships          StoreMembership[]
  sales                Sale[]            @relation("SoldBy")
  cancelledSales       Sale[]            @relation("CancelledBy")
  customerPayments     CustomerPayment[] @relation("ReceivedBy")
  saleReturns          SaleReturn[]      @relation("ReturnedBy")
  inventoriesStarted   InventoryCount[]  @relation("InventoryStartedBy")
  inventoriesValidated InventoryCount[]  @relation("InventoryValidatedBy")
  stockMovements       StockMovement[]   @relation("MovedBy")
}

model StoreMembership {
  id      String @id @default(cuid())
  userId  String
  storeId String
  role    Role   @default(VENDEUR)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id             String    @id @default(cuid())
  storeId        String
  name           String
  sku            String?
  barcode        String?
  categoryId     String?
  unit           String    @default("pièce")
  costPrice      Float     @default(0)
  sellPrice      Float     @default(0)
  quantity       Float     @default(0)
  alertThreshold Float     @default(5)
  expirationDate DateTime?
  imageUrl       String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category           Category?            @relation(fields: [categoryId], references: [id])
  stockMovements     StockMovement[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  saleReturnItems    SaleReturnItem[]
  inventoryItems     InventoryCountItem[]

  @@index([storeId])
  @@index([barcode])
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

model StockMovement {
  id        String            @id @default(cuid())
  storeId   String
  productId String
  type      StockMovementType
  quantity  Float
  reason    String?
  userId    String?
  createdAt DateTime          @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation("MovedBy", fields: [userId], references: [id])

  @@index([storeId, productId])
}

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([storeId])
}

enum PurchaseOrderStatus {
  EN_ATTENTE
  RECU
  ANNULE
}

enum PaymentStatus {
  IMPAYE
  PARTIEL
  PAYE
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  storeId       String
  supplierId    String
  status        PurchaseOrderStatus @default(EN_ATTENTE)
  paymentStatus PaymentStatus       @default(IMPAYE)
  totalAmount   Float               @default(0)
  amountPaid    Float               @default(0)
  orderDate     DateTime            @default(now())
  receivedDate  DateTime?
  notes         String?

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([storeId])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

enum SaleChannel {
  MAGASIN
  MOBILE_MONEY
  CARTE
  VIREMENT
}

model Sale {
  id            String      @id @default(cuid())
  storeId       String
  userId        String?
  clientName    String?
  clientPhone   String?
  subtotal      Float
  taxAmount     Float
  total         Float
  paymentMethod SaleChannel @default(MAGASIN)
  paymentRef    String?
  offlineId     String?     @unique
  invoiceNumber String?     @unique
  createdAt     DateTime    @default(now())
  // Annulation : la vente reste en base (traçabilité, numérotation des factures sans trou)
  // mais est exclue du chiffre d'affaires, et son stock est réintégré.
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  // Vente à crédit : client (obligatoire pour un crédit) et montant restant dû.
  // 0 pour une vente payée comptant (y compris toutes les ventes antérieures au crédit).
  customerId    String?
  balanceDue    Float       @default(0)

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User?        @relation("SoldBy", fields: [userId], references: [id])
  cancelledBy User?        @relation("CancelledBy", fields: [cancelledById], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  items       SaleItem[]
  returns     SaleReturn[]

  @@index([storeId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id               String @id @default(cuid())
  saleId           String
  productId        String
  quantity         Float
  unitPrice        Float
  total            Float
  returnedQuantity Float  @default(0) // Quantité déjà rendue par le client (retours partiels)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]
}

// Retour partiel ou total d'articles d'une vente : remise en stock + remboursement (ou
// réduction de la dette si la vente était à crédit).
model SaleReturn {
  id            String   @id @default(cuid())
  storeId       String
  saleId        String
  userId        String?
  reason        String
  subtotal      Float
  taxAmount     Float
  total         Float
  creditApplied Float    @default(0) // Part déduite du reste dû ; total - creditApplied = remboursé au client
  createdAt     DateTime @default(now())

  store Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale  Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user  User?            @relation("ReturnedBy", fields: [userId], references: [id])
  items SaleReturnItem[]

  @@index([storeId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id           String @id @default(cuid())
  saleReturnId String
  saleItemId   String
  productId    String
  quantity     Float
  unitPrice    Float
  total        Float

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

// Client enregistré : permet les ventes à crédit et le suivi des dettes.
model Customer {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  phone       String?
  address     String?
  notes       String?
  creditLimit Float? // Plafond de crédit (vide = pas de limite)
  createdAt   DateTime @default(now())

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments CustomerPayment[]

  @@index([storeId])
}

// Remboursement d'une dette client, réparti automatiquement sur ses ventes les plus anciennes.
model CustomerPayment {
  id         String      @id @default(cuid())
  storeId    String
  customerId String
  amount     Float
  method     SaleChannel @default(MAGASIN)
  note       String?
  userId     String?
  createdAt  DateTime    @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation("ReceivedBy", fields: [userId], references: [id])

  @@index([storeId, createdAt])
  @@index([customerId])
}

enum InventoryStatus {
  EN_COURS
  VALIDE
  ANNULE
}

// Inventaire physique : comptage réel des produits, puis ajustement du stock sur les écarts.
model InventoryCount {
  id            String          @id @default(cuid())
  storeId       String
  status        InventoryStatus @default(EN_COURS)
  notes         String?
  userId        String?
  validatedById String?
  createdAt     DateTime        @default(now())
  validatedAt   DateTime?

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User?                @relation("InventoryStartedBy", fields: [userId], references: [id])
  validatedBy User?                @relation("InventoryValidatedBy", fields: [validatedById], references: [id])
  items       InventoryCountItem[]

  @@index([storeId, createdAt])
}

model InventoryCountItem {
  id          String @id @default(cuid())
  inventoryId String
  productId   String
  // Stock théorique au moment où le comptage est saisi (et non au début de l'inventaire) :
  // les ventes faites entre le début de l'inventaire et le comptage ne créent pas de faux écart.
  expectedQty Float
  countedQty  Float?

  inventory InventoryCount @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, productId])
}

enum ExpenseCategory {
  LOYER
  SALAIRES
  TRANSPORT
  ACHAT_FOURNITURES
  ELECTRICITE_EAU
  MARKETING
  AUTRE
}

model Expense {
  id       String          @id @default(cuid())
  storeId  String
  category ExpenseCategory @default(AUTRE)
  label    String
  amount   Float
  date     DateTime        @default(now())
  notes    String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}

enum MobileMoneyProvider {
  ORANGE_MONEY
  AIRTEL_MONEY
  MPESA
  CINETPAY
  MOCK
}

enum MobileMoneyStatus {
  EN_ATTENTE
  REUSSI
  ECHEC
}

model MobileMoneyTransaction {
  id          String              @id @default(cuid())
  storeId     String
  saleId      String?
  provider    MobileMoneyProvider
  phone       String
  amount      Float
  status      MobileMoneyStatus   @default(EN_ATTENTE)
  externalRef String?
  // Lien de paiement à ouvrir/scanner (flux Orange Money Web Payment, redirection navigateur).
  paymentUrl  String?
  createdAt   DateTime            @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}
