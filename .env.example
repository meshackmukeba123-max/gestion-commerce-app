# Base de données PostgreSQL (ex. Neon, Supabase, Railway — ou `vercel install neon`
# qui remplit automatiquement cette variable si le projet est lié à Vercel).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/nom_base?sslmode=require"

# Clé secrète utilisée pour signer les sessions (JWT). Changez-la en production !
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="changez-cette-valeur-en-production-0123456789abcdef"

# Mobile Money (optionnel). Sans ces clés, le fournisseur "MOCK" (démo) est utilisé automatiquement.
ORANGE_MONEY_API_KEY=
AIRTEL_MONEY_API_KEY=
MPESA_API_KEY=
