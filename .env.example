# Base de données PostgreSQL (ex. Neon, Supabase, Railway — ou `vercel install neon`
# qui remplit automatiquement cette variable si le projet est lié à Vercel).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/nom_base?sslmode=require"

# Clé secrète utilisée pour signer les sessions (JWT). Changez-la en production !
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="changez-cette-valeur-en-production-0123456789abcdef"

# Mobile Money (optionnel). Sans ces clés, le fournisseur "MOCK" (démo) est utilisé automatiquement.

# CinetPay (agrégateur : Orange Money, Airtel Money, MTN Money, Moov Money, carte…) —
# RECOMMANDÉ : une seule inscription donne accès à plusieurs opérateurs sans négocier un
# accord marchand séparé avec chacun. Inscription + mode test gratuits sur https://cinetpay.com.
# 1. Créez un compte gratuit, puis dans le tableau de bord : Intégration → récupérez APIKEY et SITE_ID.
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# URL PUBLIQUE (https) où CinetPay enverra la confirmation de paiement, ex:
# https://votre-app.vercel.app/api/payments/mobile-money/cinetpay-callback
CINETPAY_NOTIFY_URL=
# Page vers laquelle le client est redirigé après paiement (optionnel, sinon = NOTIFY_URL)
CINETPAY_RETURN_URL=

# Orange Money (API Web Payment, intégration DIRECTE) — nécessite un accord marchand séparé
# avec Orange Money (pas juste un compte developer.orange.com) ; préférez CinetPay ci-dessus
# si vous n'avez pas encore cet accord.
# 1. Créez un compte gratuit sur https://developer.orange.com et une "app" Orange Money.
# 2. Copiez le Client ID / Client Secret, et la "merchant key" fournie avec votre compte marchand
#    (sandbox ou réel selon votre pays).
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Code pays Orange en minuscules (ex: cd = RD Congo, ci = Côte d'Ivoire, sn = Sénégal…)
ORANGE_MONEY_COUNTRY=cd
# URL de base de l'API (rarement à changer)
ORANGE_MONEY_BASE_URL=https://api.orange.com
# URL PUBLIQUE (https) où Orange enverra la confirmation de paiement, ex:
# https://votre-app.vercel.app/api/payments/mobile-money/orange-callback
ORANGE_MONEY_NOTIF_URL=
# Page vers laquelle le client est redirigé après paiement (optionnel, sinon = NOTIF_URL)
ORANGE_MONEY_RETURN_URL=

# Airtel Money (OpenAPI Collections) — intégration réelle, sandbox UAT gratuit.
# 1. Créez un compte gratuit sur https://developers.airtel.africa et une "app" (environnement UAT).
# 2. Copiez le Client ID / Client Secret ci-dessous.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# "sandbox" (par défaut, UAT gratuit) ou "production"
AIRTEL_ENV=sandbox
# Code pays (ex: CD = RD Congo, KE = Kenya, UG = Ouganda…) et indicatif téléphonique associé.
AIRTEL_COUNTRY=CD
AIRTEL_COUNTRY_CODE=243
AIRTEL_CURRENCY_DEFAULT=CDF

# M-Pesa (API Daraja / Safaricom) — intégration réelle, fonctionne en sandbox gratuitement.
# 1. Créez un compte gratuit sur https://developer.safaricom.co.ke et une "app" (sandbox).
# 2. Copiez son Consumer Key / Consumer Secret ci-dessous.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# "sandbox" (par défaut, gratuit, pour tester) ou "production" (nécessite un shortcode marchand réel)
MPESA_ENV=sandbox
# Shortcode + passkey : valeurs de test sandbox déjà fournies par défaut dans le code si absentes ici.
# En production, Safaricom vous fournit votre propre shortcode marchand et passkey.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Indicatif pays pour normaliser les numéros de téléphone (254 = Kenya par défaut).
MPESA_COUNTRY_CODE=254
# URL PUBLIQUE (https) où Safaricom enverra la confirmation de paiement, ex:
# https://votre-app.vercel.app/api/payments/mobile-money/mpesa-callback
# (ne fonctionne pas avec localhost — utilisez un tunnel comme ngrok pour tester en local)
MPESA_CALLBACK_URL=
